{
  "format_version": "1.21.90",
  "minecraft:block": {
    "description": {
      "identifier": "lpsm_canned:apple_can",
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": ["minecraft:cardinal_direction"]
        }
      },
      "states": {
        "lpsm_canned:cans": [1, 2, 3, 4, 5, 6, 7, 8]
      }
    },
    "components": {
      "minecraft:light_dampening": 0,
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 0.5
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destory": 0.5
      },
      "minecraft:on_player_placing": {
        "event": "lpsm_canned:on_player_placing"
      },
      "minecraft:on_interact": {
        "event": "lpsm_canned:increase_cans",
        "condition": "q.is_item_name_any('slot.weapon.mainhand','lpsm_canned:apple_can')&&q.block_state('lpsm_canned:cans')!=8"
      },
      "minecraft:material_instances": {
        "*": {
          "texture": "lpsm_canned:canned",
          "render_method": "alpha_test"
        }
      }
    },
    "events": {
      "lpsm_canned:on_player_placing": {
        "set_block_state": {
          "lpsm_canned:cans": "math.random_integer(2, 5)"
        }
      },
      "lpsm_canned:increase_cans": {
        "decrement_stack": {},
        "set_block_state": {
          "lpsm_canned:cans": "q.block_state('lpsm_canned:cans')+1"
        },
        "run_command": {
          "command": ["playsound block.lantern.step @a[r=17] ~ ~ ~"]
        }
      }
    }
  }
}
